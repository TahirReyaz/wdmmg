# Copy to .env (same folder) and fill in. Values from your Neon dashboard:
# Neon shows: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# JDBC form needs user/password split out:
DB_URL=jdbc:postgresql://ep-your-endpoint-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your-neon-password

JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:3000

# First admin account (created on startup if it doesn't exist)
ADMIN_EMAIL=admin@expense.app
ADMIN_PASSWORD=Admin@12345

# ---- Email (Google Workspace / Gmail) ----
# 1. Turn on 2-Step Verification for the mailbox account.
# 2. Create an App Password: Google Account > Security > App passwords (16 characters, no spaces).
# 3. For inbound mail: Gmail settings > Forwarding and POP/IMAP > Enable IMAP.
# MAIL_ENABLED=false writes emails (e.g. verification codes) to the backend log instead of sending.
MAIL_ENABLED=false
# How mail is sent: smtp (below) or resend (HTTPS API – use on hosts that block SMTP, e.g. Render free).
MAIL_PROVIDER=smtp
# With MAIL_PROVIDER=resend: API key from resend.com → API Keys; MAIL_FROM must be on a domain verified there.
RESEND_API_KEY=re_your_resend_api_key
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-mailbox@your-domain.com
MAIL_PASSWORD=your-16-char-app-password
MAIL_FROM=your-mailbox@your-domain.com
MAIL_FROM_NAME=Where did my money go

# Inbound: users email expenses to the app ("I had an ice cream for 30rs").
# imap   = log into a mailbox and poll it (MAIL_USERNAME / MAIL_PASSWORD, or MAIL_IMAP_USERNAME / MAIL_IMAP_PASSWORD)
# resend = Resend receiving on your domain posts each email to https://<backend>/api/inbound/resend
MAIL_INBOUND_ENABLED=false
MAIL_INBOUND_PROVIDER=imap
# With MAIL_INBOUND_PROVIDER=resend: the webhook's signing secret (Resend → Webhooks). RESEND_API_KEY needs Full access.
RESEND_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
MAIL_IMAP_HOST=imap.gmail.com
MAIL_IMAP_PORT=993
MAIL_POLL_SECONDS=60

# ---- AI (Gemini): turns expense emails into expenses and writes the Analytics summary ----
# Get a key at https://aistudio.google.com/apikey . none = AI off (emails are only logged).
AI_PROVIDER=none
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Frontend address, used for links in emails
APP_PUBLIC_URL=http://localhost:3000
