# Copy to .env (same folder) and fill in. Values from your Neon dashboard:
# Neon shows: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# JDBC form needs user/password split out:
DB_URL=jdbc:postgresql://ep-your-endpoint-123456.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DB_USERNAME=neondb_owner
DB_PASSWORD=your-neon-password

JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
CORS_ORIGINS=http://localhost:3000

# First admin account (created on startup if it doesn't exist)
ADMIN_EMAIL=admin@expense.app
ADMIN_PASSWORD=Admin@12345
