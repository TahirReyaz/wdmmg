# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real file.
# ---------------------------------------------------------------------------

# Neon: use the POOLED endpoint (the host with "-pooler" in it).
DATABASE_URL=jdbc:postgresql://ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_USER=neondb_owner
DATABASE_PASSWORD=

# At least 32 characters. Generate with:  openssl rand -base64 48
APP_JWT_SECRET=

# Where the Next.js app runs. Comma separated for more than one.
CORS_ORIGINS=http://localhost:3000

# true in every deployed environment; false only for local http
COOKIE_SECURE=false
COOKIE_DOMAIN=

PORT=8080
